{
  "name": "csc-welfare-synthesizer",
  "private": true,
  "scripts": {
    "dev": "npm run stop && concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "dev:backend": "cd backend && .venv\\Scripts\\python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
